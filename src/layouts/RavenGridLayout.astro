---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "RavenGrid | UAS Flight Planning",
  description = "RavenGrid is a field-focused UAS flight planning and conditions reference tool."
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" />
  </head>

  <body>
    <slot />
  </body>
</html>

<style>
  :global(html) {
    background: #08090b;
    color: #e5e7eb;
  }

  :global(body) {
    margin: 0;
    min-height: 100vh;
    background: #08090b;
    font-family: Arial, Helvetica, sans-serif;
  }
</style>