---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const footageCollections = await getCollection("footageCollections");
---

<BaseLayout>

<section
id="collections"
class="
py-24
bg-raven-black
"
>

<div
class="
max-w-7xl
mx-auto
px-6
lg:px-8
"
>

<!-- Header -->

<div class="max-w-4xl">

<p
class="
uppercase
tracking-[0.3em]
text-glacier-blue
text-sm
font-semibold
"
>
Digital Archive // Collections
</p>


<h1
class="
mt-5
text-5xl
md:text-6xl
font-heading
font-bold
uppercase
"
>
RavenØrix Collections
</h1>


<p
class="
mt-6
max-w-3xl
text-lg
md:text-xl
text-gray-300
leading-relaxed
"
>
Cinematic aerial footage and digital assets captured across
Alaska's wild places — built for filmmakers, creators, and
anyone looking to bring the character of the North into their work.
</p>

</div>


<!-- Aerial Footage -->

<div class="mt-20">

<div class="flex items-end justify-between gap-6">

<div>

<p
class="
uppercase
tracking-[0.3em]
text-glacier-blue
text-sm
font-semibold
"
>
Collection Type // 01
</p>


<h2
class="
mt-3
text-3xl
md:text-4xl
font-heading
font-bold
uppercase
"
>
Aerial Footage
</h2>

</div>

</div>

<!-- Footage Cards -->

<div
class="
mt-10
grid
md:grid-cols-2
lg:grid-cols-3
gap-6
"
>

{footageCollections.map((collection) => (
  <a
    href={`/collections/${collection.data.slug}/${collection.data.year}/`}
    class="group rounded-2xl border border-white/10 bg-black/30 overflow-hidden transition duration-300 hover:border-glacier-blue/50 hover:-translate-y-1"
  >

    <div class="aspect-square bg-black/50 overflow-hidden">

      <img
        src={collection.data.thumbnail}
        alt={`${collection.data.location} ${collection.data.year}`}
        class="w-full h-full object-cover transition duration-500 group-hover:scale-105"
      />

    </div>

    <div class="p-6">

      <p class="text-xs uppercase tracking-[0.2em] text-glacier-blue font-semibold">
        Juneau // Southeast Alaska
      </p>

      <h3 class="mt-3 font-heading text-2xl font-semibold group-hover:text-glacier-blue transition">
        {collection.data.location}
      </h3>

      <p class="mt-3 text-gray-400 leading-relaxed">
        {collection.data.description}
      </p>

      <div class="mt-6 text-glacier-blue font-semibold">
        Explore Collection →
      </div>

    </div>

  </a>
))}


</div>

</div>

</div>

</section>

</BaseLayout>