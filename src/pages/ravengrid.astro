---
import RavenGridLayout from "../layouts/RavenGridLayout.astro";

const betaRequestLink = "/ravengrid/beta";

const playLink =
  "https://play.google.com/apps/testing/com.ravenorix.ravengrid";

const formspreeEndpoint =
  "https://formspree.io/f/mppzokaj";
---

<RavenGridLayout
  title="RavenGrid | Closed Beta"
  description="RavenGrid is a field-focused UAS flight planning and conditions reference tool. Join the RavenGrid closed beta."
>

  <!-- NAVIGATION -->

  <header>
    <div class="nav">

      <a href="/" class="brand">
        RAVEN<span>GRID</span>
      </a>

      <nav>
        <a href="#beta">Beta</a>
        <a href="#screens">App</a>
        <a href="#features">Features</a>
        <a href="#feedback">Feedback</a>
        <a href="/privacy">Privacy</a>
      </nav>

    </div>
  </header>


  <main>

    <!-- HERO -->

    <section class="hero">

      <div class="hero-image"></div>

      <div class="hero-grid"></div>

      <div class="hero-content">

        <div class="status">
          <span class="status-dot"></span>
          CLOSED BETA / ANDROID
        </div>

        <div class="eyebrow">
          RAVENØRIX / UAS FLIGHT SYSTEM
        </div>

        <h1>
          CHECK<br />
          <span>CONDITIONS.</span>
        </h1>

        <div class="hero-divider"></div>

        <p class="hero-tagline">
          MAKE A DECISION.<br />
          <strong>FLY INFORMED.</strong>
        </p>

        <p class="hero-description">
          RavenGrid brings weather, aviation conditions, GNSS,
          airspace information, and flight planning into one
          focused field reference for UAS pilots.
        </p>

        <div class="actions">

          <a
            class="primary"
            href={betaRequestLink}
          >
            REQUEST BETA ACCESS
          </a>

          <a class="secondary" href="#screens">
            SEE THE APP
          </a>

        </div>

      </div>

      <div class="hero-corner">
        <span>RG / 01</span>
        <span>FIELD REFERENCE</span>
      </div>

    </section>


    <!-- INTRO / PRODUCT STATEMENT -->

    <section class="intro">

      <div class="intro-mark">
        <span>01</span>
        <div></div>
      </div>

      <div class="intro-copy">

        <div class="section-label">
          BUILT FOR THE FIELD
        </div>

        <h2>
          THE INFORMATION<br />
          <span>YOU NEED.</span>
        </h2>

        <p>
          RavenGrid is designed around a simple idea:
          preflight information shouldn't take a dozen
          screens to understand.
        </p>

        <p>
          Weather, positioning, aviation information,
          airspace awareness, and flight planning are
          organized into a single workflow built for
          quick reference before you fly.
        </p>

      </div>

      <div class="intro-specs">

        <div>
          <span>PLATFORM</span>
          <strong>ANDROID</strong>
        </div>

        <div>
          <span>STATUS</span>
          <strong>CLOSED BETA</strong>
        </div>

        <div>
          <span>FOCUS</span>
          <strong>UAS / DRONE</strong>
        </div>

      </div>

    </section>


    <!-- APP SCREENSHOTS -->

    <section id="screens" class="screens">

      <div class="screens-header">

        <div>
          <div class="section-label">
            02 / THE APPLICATION
          </div>

          <h2>
            SEE RAVENGRID<br />
            <span>IN ACTION.</span>
          </h2>
        </div>

        <p>
          A focused flight-planning workflow built around
          the information pilots actually need before launch.
        </p>

      </div>


      <div class="phone-showcase">

        <div class="phone phone-1">
          <div class="phone-frame">
            <img
              src="/images/ravengrid/1636.jpg"
              alt="RavenGrid application weather screen"
              loading="lazy"
            />
          </div>
          <div class="phone-label">
            <span>01</span>
            CONDITIONS
          </div>
        </div>


        <div class="phone phone-2">
          <div class="phone-frame">
            <img
              src="/images/ravengrid/1638.jpg"
              alt="RavenGrid application flight planning screen"
              loading="lazy"
            />
          </div>
          <div class="phone-label">
            <span>02</span>
            FLIGHT PLANNING
          </div>
        </div>


        <div class="phone phone-3">
          <div class="phone-frame">
            <img
              src="/images/ravengrid/1640.jpg"
              alt="RavenGrid application aviation information screen"
              loading="lazy"
            />
          </div>
          <div class="phone-label">
            <span>03</span>
            AVIATION
          </div>
        </div>


        <div class="phone phone-4">
          <div class="phone-frame">
            <img
              src="/images/ravengrid/1642.jpg"
              alt="RavenGrid application map screen"
              loading="lazy"
            />
          </div>
          <div class="phone-label">
            <span>04</span>
            MAPPING
          </div>
        </div>

      </div>

    </section>


    <!-- FEATURE IMAGE -->

    <section class="feature-visual">

      <div class="feature-visual-image">
        <img
          src="/images/ravengrid/ravengrid-featureimage-1024.png"
          alt="RavenGrid UAS flight planning application"
          loading="lazy"
        />
      </div>

      <div class="feature-visual-overlay"></div>

      <div class="feature-visual-content">

        <div class="section-label">
          RAVENØRIX / RAVENGRID
        </div>

        <h2>
          LESS BLOAT.<br />
          <span>MORE CLARITY.</span>
        </h2>

        <p>
          RavenGrid keeps the preflight picture focused,
          giving pilots a faster way to understand the
          conditions around their operating area.
        </p>

        <a
          class="primary"
          href={betaRequestLink}
        >
          REQUEST BETA ACCESS
        </a>

      </div>

    </section>


    <!-- BETA -->

    <section id="beta" class="beta">

      <div class="section-label">
        03 / CLOSED BETA
      </div>

      <div class="beta-heading">

        <h2>
          HELP BUILD<br />
          <span>RAVENGRID.</span>
        </h2>

        <p>
          RavenGrid is currently being tested ahead of its
          public launch on Google Play. We're looking for
          Android users, UAS pilots, and aviation enthusiasts
          to put the app through real-world use.
        </p>

      </div>


      <div class="beta-grid">

        <article class="beta-card">

          <div class="number">01</div>

          <div>
            <h3>REQUEST ACCESS</h3>

            <p>
              Submit the Google Play account you use for
              testing. We'll add your account to the
              RavenGrid closed-test tester list.
            </p>
          </div>

        </article>


        <article class="beta-card">

          <div class="number">02</div>

          <div>
            <h3>TEST</h3>

            <p>
              Use RavenGrid for weather, mapping,
              positioning, aviation information, and
              flight planning.
            </p>
          </div>

        </article>


        <article class="beta-card">

          <div class="number">03</div>

          <div>
            <h3>REPORT</h3>

            <p>
              Tell us what works, what doesn't, and what
              would make RavenGrid better.
            </p>
          </div>

        </article>

      </div>


      <div class="requirements">

        <div class="requirements-list">

          <div class="section-label">
            BETA REQUIREMENTS
          </div>

          <ul>
            <li>Android device</li>
            <li>Google account</li>
            <li>Submit a beta access request</li>
            <li>Install RavenGrid through Google Play</li>
            <li>Remain enrolled in the beta for 14 days</li>
            <li>Use the app and provide honest feedback</li>
          </ul>

        </div>


        <div class="requirement-note">

          <div class="note-top">
            <span class="status-dot"></span>
            ALREADY APPROVED?
          </div>

          <div class="note-title">
            READY TO INSTALL?
          </div>

          <p>
            If your Google Play account has already been
            added to the RavenGrid tester list, use the
            link below to enroll and install the app.
          </p>

          <a
            href={playLink}
            target="_blank"
            rel="noopener noreferrer"
          >
            INSTALL RAVENGRID
            <span>→</span>
          </a>

        </div>

      </div>

    </section>


    <!-- FEATURES -->

    <section id="features" class="features">

      <div class="section-label">
        04 / WHAT YOU'LL TEST
      </div>

      <div class="features-heading">

        <h2>
          FIELD INFORMATION.<br />
          <span>ONE WORKFLOW.</span>
        </h2>

        <p>
          RavenGrid combines the core information needed
          for a fast preflight assessment without forcing
          pilots through unnecessary layers of information.
        </p>

      </div>


      <div class="feature-grid">

        <article>

          <div class="number">01</div>

          <h3>WEATHER</h3>

          <p>
            Wind, gusts, visibility, ceiling, precipitation,
            UV index, and live aviation weather.
          </p>

        </article>


        <article>

          <div class="number">02</div>

          <h3>GNSS</h3>

          <p>
            Satellite information and device positioning
            for location-aware flight planning.
          </p>

        </article>


        <article>

          <div class="number">03</div>

          <h3>AIRSPACE</h3>

          <p>
            TFR information and direct access to FAA NOTAM
            resources for additional awareness.
          </p>

        </article>


        <article>

          <div class="number">04</div>

          <h3>MAPPING</h3>

          <p>
            Standard, topographic, and flight map layers
            for planning and situational awareness.
          </p>

        </article>


        <article>

          <div class="number">05</div>

          <h3>FLIGHT PROFILES</h3>

          <p>
            Commercial, recreational, and cinematic
            profiles designed around different operating
            thresholds.
          </p>

        </article>


        <article>

          <div class="number">06</div>

          <h3>GEOMAGNETIC</h3>

          <p>
            Kp index information to provide additional
            awareness of current geomagnetic conditions.
          </p>

        </article>

      </div>

    </section>


    <!-- FEEDBACK -->

    <section id="feedback" class="feedback">

      <div class="feedback-intro">

        <div class="section-label">
          05 / BETA FEEDBACK
        </div>

        <h2>
          TELL US WHAT<br />
          <span>YOU FIND.</span>
        </h2>

        <p>
          Your feedback during the beta directly helps
          shape the final RavenGrid release.
        </p>

      </div>


      <form
        action={formspreeEndpoint}
        method="POST"
      >

        <label>
          What did you test?

          <textarea
            name="tested"
            required
            placeholder="Weather, maps, GNSS, TFRs, NOTAMs, etc."
          ></textarea>

        </label>


        <label>
          What worked well?

          <textarea
            name="worked"
            placeholder="Tell us what you liked."
          ></textarea>

        </label>


        <label>
          What didn't work?

          <textarea
            name="problems"
            placeholder="Describe anything broken, confusing, or unexpected."
          ></textarea>

        </label>


        <label>
          What would you change?

          <textarea
            name="changes"
            placeholder="Features, layout, information, usability, etc."
          ></textarea>

        </label>


        <label>
          Device / model
          <span>(optional)</span>

          <input
            type="text"
            name="device"
            placeholder="Example: Pixel 9 Pro"
          />

        </label>


        <label>
          Additional comments
          <span>(optional)</span>

          <textarea
            name="comments"
            placeholder="Anything else you'd like us to know."
          ></textarea>

        </label>


        <button type="submit" class="primary">
          SUBMIT FEEDBACK
        </button>

      </form>

    </section>


    <!-- FINAL CTA -->

    <section class="cta">

      <div class="cta-inner">

        <div class="section-label">
          06 / RAVENGRID
        </div>

        <h2>
          READY TO<br />
          <span>FLY INFORMED?</span>
        </h2>

        <p>
          Join the closed beta and help shape the next
          generation of field-focused UAS flight planning.
        </p>

        <a
          class="primary"
          href={betaRequestLink}
        >
          REQUEST BETA ACCESS
        </a>

      </div>

    </section>

  </main>


  <!-- FOOTER -->

  <footer>

    <div class="footer-brand">
      RAVEN<span>GRID</span>
    </div>

    <div class="footer-links">
      <a href="/">RavenGrid</a>
      <a href="/privacy">Privacy Policy</a>
      <a
        href="https://ravenorix.com"
        target="_blank"
        rel="noopener noreferrer"
      >
        RavenØrix
      </a>
    </div>

    <div class="copyright">
      © 2026 RavenØrix
    </div>

  </footer>

</RavenGridLayout>


<style>

  :global(html) {
    scroll-behavior: smooth;
  }


  :global(body) {
    background: #08090b;
    color: #e5e7eb;
  }


  :global(*) {
    box-sizing: border-box;
  }


  header {
    position: relative;
    z-index: 20;
    border-bottom: 1px solid #24262a;
    background: rgba(8, 9, 11, 0.96);
  }


  .nav {
    max-width: 1280px;
    margin: auto;
    padding: 20px 28px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }


  .brand {
    color: #f3f4f6;
    text-decoration: none;
    font-size: 15px;
    font-weight: 900;
    letter-spacing: 0.16em;
  }


  .brand span,
  footer span,
  h1 span,
  h2 span {
    color: #a71930;
  }


  nav {
    display: flex;
    gap: 28px;
  }


  nav a,
  .footer-links a {
    color: #777c84;
    text-decoration: none;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    transition: color 0.2s ease;
  }


  nav a:hover,
  .footer-links a:hover {
    color: #f3f4f6;
  }


  /* HERO */


  .hero {
    position: relative;
    min-height: 760px;
    overflow: hidden;
    display: flex;
    align-items: center;
    border-bottom: 1px solid #24262a;
  }


  .hero-image {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(
        90deg,
        rgba(8, 9, 11, 0.98) 0%,
        rgba(8, 9, 11, 0.88) 38%,
        rgba(8, 9, 11, 0.48) 70%,
        rgba(8, 9, 11, 0.66) 100%
      ),
      url("/images/ravengrid/ravengrid-featureimage-1024.png");
    background-size: cover;
    background-position: center;
    transform: scale(1.01);
  }


  .hero-grid {
    position: absolute;
    inset: 0;
    opacity: 0.14;

    background-image:
      linear-gradient(
        rgba(255,255,255,0.08) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(255,255,255,0.08) 1px,
        transparent 1px
      );

    background-size: 60px 60px;

    mask-image: linear-gradient(
      90deg,
      black,
      transparent 85%
    );
  }


  .hero-content {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 1280px;
    margin: auto;
    padding: 100px 28px;
  }


  .status {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    color: #c0203b;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.18em;
    margin-bottom: 24px;
  }


  .status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #a71930;
    box-shadow: 0 0 14px rgba(167, 25, 48, 0.8);
  }


  .eyebrow,
  .section-label {
    color: #a71930;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.2em;
  }


  h1 {
    margin: 22px 0 0;
    font-size: clamp(58px, 9vw, 112px);
    line-height: 0.86;
    letter-spacing: -0.055em;
    font-weight: 900;
  }


  .hero-divider {
    width: 90px;
    height: 2px;
    margin: 34px 0 25px;
    background: #a71930;
  }


  .hero-tagline {
    margin: 0;
    color: #f3f4f6;
    font-size: clamp(22px, 3vw, 32px);
    line-height: 1.1;
    font-weight: 400;
    letter-spacing: 0.03em;
  }


  .hero-tagline strong {
    font-weight: 900;
  }


  .hero-description {
    max-width: 590px;
    margin: 24px 0 0;
    color: #a3a8b0;
    font-size: 16px;
    line-height: 1.75;
  }


  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 34px;
  }


  .primary,
  .secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 22px;
    text-decoration: none;
    font-family: inherit;
    font-size: 10px;
    font-weight: 900;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      background 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease;
  }


  .primary {
    border: 1px solid #a71930;
    background: #a71930;
    color: #fff;
  }


  .primary:hover {
    background: #c0203b;
    border-color: #c0203b;
  }


  .secondary {
    border: 1px solid #4a4e55;
    background: rgba(8, 9, 11, 0.3);
    color: #d7dae0;
  }


  .secondary:hover {
    border-color: #9a9fa7;
  }


  .hero-corner {
    position: absolute;
    z-index: 2;
    right: 28px;
    bottom: 28px;
    display: flex;
    gap: 22px;
    color: #62666d;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.15em;
  }


  /* INTRO */


  .intro {
    max-width: 1280px;
    margin: auto;
    padding: 120px 28px;
    display: grid;
    grid-template-columns: 90px minmax(0, 1.5fr) minmax(260px, 0.8fr);
    gap: 55px;
    border-bottom: 1px solid #24262a;
  }


  .intro-mark {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    color: #a71930;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.14em;
  }


  .intro-mark div {
    width: 34px;
    height: 1px;
    margin-top: 5px;
    background: #a71930;
  }


  h2 {
    margin: 18px 0 28px;
    font-size: clamp(42px, 6vw, 72px);
    line-height: 0.94;
    letter-spacing: -0.045em;
    font-weight: 900;
  }


  .intro-copy p {
    max-width: 670px;
    color: #92979f;
    font-size: 16px;
    line-height: 1.8;
  }


  .intro-specs {
    align-self: end;
    border-top: 1px solid #24262a;
  }


  .intro-specs div {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    padding: 16px 0;
    border-bottom: 1px solid #24262a;
  }


  .intro-specs span {
    color: #5f646b;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.15em;
  }


  .intro-specs strong {
    color: #c9cdd3;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.1em;
  }


  /* SCREENSHOTS */


  .screens {
    padding: 120px 28px 130px;
    border-bottom: 1px solid #24262a;
    overflow: hidden;
  }


  .screens-header {
    max-width: 1280px;
    margin: auto;
    display: grid;
    grid-template-columns: 1fr 0.65fr;
    gap: 80px;
    align-items: end;
  }


  .screens-header p {
    margin: 0 0 8px;
    max-width: 460px;
    color: #858a92;
    font-size: 15px;
    line-height: 1.75;
  }


  .phone-showcase {
    max-width: 1200px;
    margin: 75px auto 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    align-items: end;
  }


  .phone {
    min-width: 0;
  }


  .phone:nth-child(even) {
    transform: translateY(42px);
  }


  .phone-frame {
    position: relative;
    padding: 8px;
    border: 1px solid #34373d;
    border-radius: 25px;
    background: #111317;
    box-shadow:
      0 28px 60px rgba(0,0,0,0.45),
      0 0 0 1px rgba(255,255,255,0.015);
  }


  .phone-frame::before {
    content: "";
    position: absolute;
    z-index: 2;
    top: 12px;
    left: 50%;
    width: 34%;
    height: 17px;
    transform: translateX(-50%);
    border-radius: 20px;
    background: #08090b;
  }


  .phone-frame img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 18px;
  }


  .phone-label {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 17px;
    color: #777c84;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.15em;
  }


  .phone-label span {
    color: #a71930;
  }


  /* FEATURE VISUAL */


  .feature-visual {
    position: relative;
    min-height: 650px;
    display: flex;
    align-items: center;
    overflow: hidden;
    border-bottom: 1px solid #24262a;
  }


  .feature-visual-image {
    position: absolute;
    inset: 0;
  }


  .feature-visual-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }


  .feature-visual-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        90deg,
        rgba(8,9,11,0.98),
        rgba(8,9,11,0.72) 46%,
        rgba(8,9,11,0.35)
      );
  }


  .feature-visual-content {
    position: relative;
    z-index: 2;
    max-width: 1280px;
    width: 100%;
    margin: auto;
    padding: 100px 28px;
  }


  .feature-visual-content h2 {
    max-width: 680px;
    margin-bottom: 28px;
  }


  .feature-visual-content p {
    max-width: 530px;
    color: #a2a7ae;
    font-size: 16px;
    line-height: 1.8;
    margin-bottom: 32px;
  }


  /* BETA */


  .beta {
    max-width: 1280px;
    margin: auto;
    padding: 120px 28px;
    border-bottom: 1px solid #24262a;
  }


  .beta-heading {
    display: grid;
    grid-template-columns: 1fr 0.7fr;
    gap: 80px;
    align-items: end;
  }


  .beta-heading p {
    color: #92979f;
    font-size: 16px;
    line-height: 1.8;
  }


  .beta-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin-top: 65px;
    border-top: 1px solid #24262a;
    border-left: 1px solid #24262a;
  }


  .beta-card {
    min-height: 250px;
