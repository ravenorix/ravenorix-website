<script>

const estimateButton =
  document.querySelector("#estimate-button");

const advancedButton =
  document.querySelector("#advanced-button");

const customizeButton =
  document.querySelector("#customize-button");

const advancedBack =
  document.querySelector("#advanced-back");

const advancedUpdate =
  document.querySelector("#advanced-update");

const advancedIntro =
  document.querySelector("#advanced-intro");

const advancedPanel =
  document.querySelector("#advanced-panel");

const advancedCardWrapper =
  document.querySelector("#advanced-card-wrapper");

const newEstimateButton =
  document.querySelector("#new-estimate");

const results =
  document.querySelector("#results");

const reportCta =
  document.querySelector("#report-cta");

const formError =
  document.querySelector("#form-error");

const zipInput =
  document.querySelector("#zip");

const serviceInput =
  document.querySelector("#service");

const resultRange =
  document.querySelector("#result-range");

const resultRecommended =
  document.querySelector("#result-recommended");

const resultMarket =
  document.querySelector("#result-market");

const resultService =
  document.querySelector("#result-service");

const resultSize =
  document.querySelector("#result-size");

const resultCopy =
  document.querySelector("#result-copy");

const advancedMarket =
  document.querySelector("#advanced-market");

const advancedService =
  document.querySelector("#advanced-service");

const advancedSize =
  document.querySelector("#advanced-size");

const advancedRecommended =
  document.querySelector("#advanced-recommended");

const advancedRange =
  document.querySelector("#advanced-range");


/* =========================================================
   PROJECT SIZE
========================================================= */

function getProjectSize() {

  const selected =
    document.querySelector(
      'input[name="project-size"]:checked'
    );

  return selected?.value || "";

}


/* =========================================================
   FORMATTING
========================================================= */

function formatService(value) {

  const services = {

    photography:"Aerial Photography",
    video:"Aerial Video",
    "photo-video":"Photo + Video",
    "real-estate":"Real Estate",
    commercial:"Commercial / Business",
    construction:"Construction / Property",
    inspection:"Inspection",
    other:"Other"

  };

  return services[value] || "—";

}


function formatSize(value) {

  const sizes = {

    quick:"Quick",
    standard:"Standard",
    large:"Large / Complex"

  };

  return sizes[value] || "—";

}


/* =========================================================
   TEMPORARY PRICING MODEL
========================================================= */

function estimatePrice(service,size) {

  /*
   * TEMPORARY UI TESTING MODEL
   *
   * This is intentionally NOT the final pricing engine.
   * It will eventually be replaced by the real market-data model.
   */

  const base = {

    photography:325,
    video:425,
    "photo-video":550,
    "real-estate":400,
    commercial:650,
    construction:700,
    inspection:600,
    other:400

  };

  const multipliers = {

    quick:.8,
    standard:1,
    large:1.45

  };

  const center =
    (base[service] || 400) *
    (multipliers[size] || 1);

  const low =
    Math.round((center * .85) / 25) * 25;

  const high =
    Math.round((center * 1.15) / 25) * 25;

  const recommended =
    Math.round(center / 25) * 25;

  return {
    low,
    high,
    recommended
  };

}


/* =========================================================
   TEMPORARY MARKET RESOLUTION
========================================================= */

function getMarketFromZip(zip) {

  const alaskaZips = {

    "99801":"Juneau, Alaska",
    "99802":"Juneau, Alaska",
    "99803":"Juneau, Alaska",
    "99824":"Juneau, Alaska",
    "99827":"Juneau, Alaska"

  };

  return alaskaZips[zip] || "Local Market";

}


/* =========================================================
   ADVANCED FACTORS
========================================================= */

function getAdvancedMultiplier(name) {

  const selected =
    document.querySelector(
      `input[name="${name}"]:checked`
    );

  return Number(selected?.value || 1);

}


function calculateAdvancedEstimate(basePrice) {

  const multiplier =
    getAdvancedMultiplier("advanced-time") *
    getAdvancedMultiplier("advanced-travel") *
    getAdvancedMultiplier("advanced-editing") *
    getAdvancedMultiplier("advanced-equipment") *
    getAdvancedMultiplier("advanced-usage") *
    getAdvancedMultiplier("advanced-turnaround") *
    getAdvancedMultiplier("advanced-complexity");

  const center =
    basePrice * multiplier;

  const low =
    Math.round((center * .9) / 25) * 25;

  const high =
    Math.round((center * 1.1) / 25) * 25;

  const recommended =
    Math.round(center / 25) * 25;

  return {
    low,
    high,
    recommended
  };

}


/* =========================================================
   ADVANCED WORKFLOW
========================================================= */

function openAdvanced() {

  if (!zipInput?.value || !serviceInput?.value) {

    advancedButton?.scrollIntoView({
      behavior:"smooth",
      block:"center"
    });

    return;

  }

  advancedIntro?.setAttribute(
    "hidden",
    ""
  );

  advancedPanel?.classList.add("visible");

  advancedPanel?.setAttribute(
    "aria-hidden",
    "false"
  );

  advancedCardWrapper?.classList.add(
    "advanced-open"
  );

  advancedMarket.textContent =
    getMarketFromZip(zipInput.value.trim());

  advancedService.textContent =
    formatService(serviceInput.value);

  advancedSize.textContent =
    formatSize(getProjectSize());

  updateAdvancedEstimate();

  advancedPanel?.scrollIntoView({
    behavior:"smooth",
    block:"start"
  });

}


function updateAdvancedEstimate() {

  const service =
    serviceInput?.value;

  const size =
    getProjectSize();

  if (!service || !size) {
    return;
  }

  const basePricing =
    estimatePrice(service,size);

  const advanced =
    calculateAdvancedEstimate(
      basePricing.recommended
    );

  advancedRecommended.textContent =
    `$${advanced.recommended.toLocaleString()}`;

  advancedRange.textContent =
    `Estimated Market Range: $${advanced.low.toLocaleString()} – $${advanced.high.toLocaleString()}`;

}


/* =========================================================
   GENERATE QUICK ESTIMATE
========================================================= */

estimateButton?.addEventListener("click",() => {

  const zip =
    zipInput?.value.trim();

  const service =
    serviceInput?.value;

  const size =
    getProjectSize();

  formError.textContent = "";

  if (!/^\d{5}$/.test(zip)) {

    formError.textContent =
      "Enter a valid 5-digit ZIP code.";

    zipInput?.focus();

    return;

  }

  if (!service) {

    formError.textContent =
      "Select a service type.";

    serviceInput?.focus();

    return;

  }

  if (!size) {

    formError.textContent =
      "Select an approximate project size.";

    return;

  }

  const pricing =
    estimatePrice(service,size);

  resultRange.textContent =
    `$${pricing.low.toLocaleString()} – $${pricing.high.toLocaleString()}`;

  resultRecommended.textContent =
    `$${pricing.recommended.toLocaleString()}`;

  resultMarket.textContent =
    getMarketFromZip(zip);

  resultService.textContent =
    formatService(service);

  resultSize.textContent =
    formatSize(size);

  resultCopy.textContent =
    `This estimate is a starting point for ${formatService(service).toLowerCase()} in the ${getMarketFromZip(zip)} market at a ${formatSize(size).toLowerCase()} project level. Actual pricing can vary based on deliverables, travel, production time, licensing, experience, and project requirements.`;

  advancedMarket.textContent =
    getMarketFromZip(zip);

  advancedService.textContent =
    formatService(service);

  advancedSize.textContent =
    formatSize(size);

  results.classList.add("visible");

  results.setAttribute(
    "aria-hidden",
    "false"
  );

  reportCta.classList.add("visible");

  reportCta.setAttribute(
    "aria-hidden",
    "false"
  );

  results.scrollIntoView({
    behavior:"smooth",
    block:"start"
  });

});


/* =========================================================
   NEW ESTIMATE
========================================================= */

newEstimateButton?.addEventListener("click",() => {

  results.classList.remove("visible");

  reportCta.classList.remove("visible");

  results.setAttribute(
    "aria-hidden",
    "true"
  );

  reportCta.setAttribute(
    "aria-hidden",
    "true"
  );

  window.scrollTo({
    top:0,
    behavior:"smooth"
  });

});


/* =========================================================
   ADVANCED BUTTONS
========================================================= */

customizeButton?.addEventListener("click",() => {

  openAdvanced();

});


advancedButton?.addEventListener("click",() => {

  openAdvanced();

});


advancedBack?.addEventListener("click",() => {

  advancedPanel?.classList.remove("visible");

  advancedPanel?.setAttribute(
    "aria-hidden",
    "true"
  );

  advancedIntro?.removeAttribute("hidden");

  advancedCardWrapper?.classList.remove(
    "advanced-open"
  );

  advancedIntro?.scrollIntoView({
    behavior:"smooth",
    block:"start"
  });

});


advancedUpdate?.addEventListener("click",() => {

  updateAdvancedEstimate();

  advancedRecommended?.scrollIntoView({
    behavior:"smooth",
    block:"center"
  });

});


/* =========================================================
   LIVE ADVANCED UPDATES
========================================================= */

document
  .querySelectorAll(
    '.factor-option input[type="radio"]'
  )
  .forEach((input) => {

    input.addEventListener(
      "change",
      updateAdvancedEstimate
    );

  });

</script>

</BaseLayout>