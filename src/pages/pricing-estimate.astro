---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/ui/Container.astro";
import Card from "../components/ui/Card.astro";
---

<BaseLayout
  title="Drone Pricing Estimate | RavenØrix"
  description="Estimate the local market rate for your drone photography and aerial media projects."
>

<section class="pricing-page">

  <Container>

    <!-- HEADER -->

    <div class="pricing-header">

      <p class="pricing-eyebrow">
        RAVENØRIX // PRICING TOOL
      </p>

      <h1>
        Drone Pricing<br />
        <span>Estimate</span>
      </h1>

      <p class="pricing-intro">
        Get an estimated local market rate for your drone work —
        or build a more personalized estimate based on your actual
        business costs.
      </p>

    </div>


    <!-- MODE SELECTOR -->

    <div class="mode-grid">

      <!-- QUICK ESTIMATE -->

      <Card padding="p-8 md:p-10" hover={false}>

        <div class="mode-number">
          01
        </div>

        <p class="mode-label">
          QUICK ESTIMATE
        </p>

        <h2>
          Estimated Local Market Rate
        </h2>

        <p class="mode-description">
          Get a quick estimate based on your location, service type,
          and approximate project size.
        </p>

        <div class="mode-fields">

          <!-- ZIP -->

          <div class="field">

            <label for="zip">
              ZIP CODE
            </label>

            <input
              id="zip"
              name="zip"
              type="text"
              inputmode="numeric"
              maxlength="5"
              placeholder="Enter ZIP code"
              autocomplete="postal-code"
            />

          </div>


          <!-- SERVICE -->

          <div class="field">

            <label for="service">
              SERVICE
            </label>

            <select id="service" name="service">

              <option value="">
                Select service
              </option>

              <option value="photography">
                Aerial Photography
              </option>

              <option value="video">
                Aerial Video
              </option>

              <option value="photo-video">
                Photo + Video
              </option>

              <option value="real-estate">
                Real Estate
              </option>

              <option value="commercial">
                Commercial / Business
              </option>

              <option value="construction">
                Construction / Property
              </option>

              <option value="inspection">
                Inspection
              </option>

              <option value="other">
                Other
              </option>

            </select>

          </div>


          <!-- PROJECT SIZE -->

          <div class="field">

            <div class="field-heading">

              <label>
                PROJECT SIZE
              </label>

              <span class="field-hint">
                Select one
              </span>

            </div>

            <div
              class="size-selector"
              role="radiogroup"
              aria-label="Project size"
            >

              <label class="size-segment">

                <input
                  type="radio"
                  name="project-size"
                  value="quick"
                />

                <span>
                  Quick
                </span>

              </label>

              <label class="size-segment selected">

                <input
                  type="radio"
                  name="project-size"
                  value="standard"
                  checked
                />

                <span>
                  Standard
                </span>

              </label>

              <label class="size-segment">

                <input
                  type="radio"
                  name="project-size"
                  value="large"
                />

                <span>
                  Large / Complex
                </span>

              </label>

            </div>

          </div>

        </div>


        <button
          id="estimate-button"
          type="button"
          class="estimate-button"
        >
          GET MY ESTIMATE
          <span>→</span>
        </button>


        <p
          id="form-error"
          class="form-error"
          aria-live="polite"
        ></p>

      </Card>


      <!-- ADVANCED -->

      <div id="advanced-card-wrapper">

        <Card padding="p-8 md:p-10" hover={false}>

          <!-- ADVANCED INTRO -->

          <div id="advanced-intro">

            <div class="mode-number muted">
              02
            </div>

            <p class="mode-label muted">
              ADVANCED PRICING
            </p>

            <h2>
              Build Your Personalized Rate
            </h2>

            <p class="mode-description">
              Go beyond market estimates. Account for the actual costs
              and requirements of your business to build a more
              personalized estimate.
            </p>

            <div class="advanced-list">

              <div>
                <span>01</span>
                Time &amp; labor
              </div>

              <div>
                <span>02</span>
                Travel &amp; mileage
              </div>

              <div>
                <span>03</span>
                Editing &amp; production
              </div>

              <div>
                <span>04</span>
                Equipment &amp; operating costs
              </div>

              <div>
                <span>05</span>
                Usage rights &amp; licensing
              </div>

              <div>
                <span>06</span>
                Turnaround
              </div>

              <div>
                <span>07</span>
                Project complexity
              </div>

            </div>

            <button
              id="advanced-button"
              type="button"
              class="advanced-button"
            >
              BUILD ADVANCED ESTIMATE
              <span>→</span>
            </button>

            <p class="carry-note">
              Your Quick Estimate information will carry over automatically.
            </p>

          </div>


          <!-- ADVANCED WORKFLOW -->

          <div
            id="advanced-panel"
            class="advanced-panel"
            aria-hidden="true"
          >

            <div class="advanced-panel-header">

              <div>

                <p class="mode-label">
                  ADVANCED PRICING
                </p>

                <h3>
                  Refine Your Estimate
                </h3>

                <p>
                  Your Quick Estimate information is already included.
                  Adjust the factors below to build a more personalized estimate.
                </p>

              </div>

              <button
                id="advanced-back"
                type="button"
                class="advanced-back"
              >
                ← BACK
              </button>

            </div>


            <!-- QUICK SUMMARY -->

            <div class="advanced-summary">

              <div>
                <span>MARKET</span>
                <strong id="advanced-market">—</strong>
              </div>

              <div>
                <span>SERVICE</span>
                <strong id="advanced-service">—</strong>
              </div>

              <div>
                <span>PROJECT</span>
                <strong id="advanced-size">—</strong>
              </div>

            </div>


            <!-- TIME -->

            <div class="advanced-factor">

              <div class="factor-heading">

                <div>
                  <span class="factor-number">01</span>
                  <h4>TIME ON SITE</h4>
                </div>

              </div>

              <p class="factor-description">
                Consider setup, flight time, waiting, multiple flights,
                and the total amount of time required on location.
              </p>

              <div class="factor-options">

                <label class="factor-option">
                  <input type="radio" name="advanced-time" value="0.95" checked />
                  <span>
                    <strong>Under 1 hour</strong>
                    <small>Simple shoot with minimal setup and flight time.</small>
                  </span>
                </label>

                <label class="factor-option">
                  <input type="radio" name="advanced-time" value="1" />
                  <span>
                    <strong>1–2 hours</strong>
                    <small>Typical single-location project with some setup and multiple flights.</small>
                  </span>
                </label>

                <label class="factor-option">
                  <input type="radio" name="advanced-time" value="1.15" />
                  <span>
                    <strong>2–4 hours</strong>
                    <small>More extensive coverage, multiple flight sessions, or additional setup.</small>
                  </span>
                </label>

                <label class="factor-option">
                  <input type="radio" name="advanced-time" value="1.3" />
                  <span>
                    <strong>4+ hours</strong>
                    <small>Long production day, extensive coverage, or significant on-site requirements.</small>
                  </span>
                </label>

              </div>

            </div>


            <!-- TRAVEL -->

            <div class="advanced-factor">

              <div class="factor-heading">
                <div>
                  <span class="factor-number">02</span>
                  <h4>TRAVEL</h4>
                </div>
              </div>

              <p class="factor-description">
                Account for additional driving, mileage, remote locations,
                ferry or air travel, and time spent getting to the project.
              </p>

              <div class="factor-options">

                <label class="factor-option">
                  <input type="radio" name="advanced-travel" value="1" checked />
                  <span>
                    <strong>Local</strong>
                    <small>Nearby project with little additional travel time or mileage.</small>
                  </span>
                </label>

                <label class="factor-option">
                  <input type="radio" name="advanced-travel" value="1.1" />
                  <span>
                    <strong>Moderate</strong>
                    <small>Noticeable drive time, mileage, or travel between locations.</small>
                  </span>
                </label>

                <label class="factor-option">
                  <input type="radio" name="advanced-travel" value="1.25" />
                  <span>
                    <strong>Significant</strong>
                    <small>Long-distance travel, remote locations, ferry/air travel, or substantial travel time.</small>
                  </span>
                </label>

              </div>

            </div>


            <!-- EDITING -->

            <div class="advanced-factor">

              <div class="factor-heading">
                <div>
                  <span class="factor-number">03</span>
                  <h4>EDITING / PRODUCTION</h4>
                </div>
              </div>

              <p class="factor-description">
                Reflect the amount of post-production required before
                the final files are ready for the client.
              </p>

              <div class="factor-options">

                <label class="factor-option">
                  <input type="radio" name="advanced-editing" value="0.9" checked />
                  <span>
                    <strong>None / Minimal</strong>
                    <small>Delivered files require little or no editing.</small>
                  </span>
                </label>

                <label class="factor-option">
                  <input type="radio" name="advanced-editing" value="1" />
                  <span>
                    <strong>Basic</strong>
                    <small>Light color correction, cropping, stabilization, or basic photo processing.</small>
                  </span>
                </label>

                <label class="factor-option">
                  <input type="radio" name="advanced-editing" value="1.15" />
                  <span>
                    <strong>Standard</strong>
                    <small>Normal photo/video editing and color grading for client delivery.</small>
                  </span>
                </label>

                <label class="factor-option">
                  <input type="radio" name="advanced-editing" value="1.35" />
                  <span>
                    <strong>Extensive</strong>
                    <small>Detailed editing, cinematic production, multiple deliverables, or substantial post-production.</small>
                  </span>
                </label>

              </div>

            </div>


            <!-- EQUIPMENT -->

            <div class="advanced-factor">

              <div class="factor-heading">
                <div>
                  <span class="factor-number">04</span>
                  <h4>EQUIPMENT</h4>
                </div>
              </div>

              <p class="factor-description">
                Account for the level of equipment, supporting gear,
                sensors, cameras, or aircraft required for the project.
              </p>

              <div class="factor-options">

                <label class="factor-option">
                  <input type="radio" name="advanced-equipment" value="1" checked />
                  <span>
                    <strong>Standard Drone</strong>
                    <small>Normal drone and standard flight equipment.</small>
                  </span>
                </label>

                <label class="factor-option">
                  <input type="radio" name="advanced-equipment" value="1.12" />
                  <span>
                    <strong>Advanced Equipment</strong>
                    <small>Higher-end drone, additional lenses, batteries, or supporting equipment.</small>
                  </span>
                </label>

                <label class="factor-option">
                  <input type="radio" name="advanced-equipment" value="1.3" />
                  <span>
                    <strong>Specialized Equipment</strong>
                    <small>Specialized sensors, thermal, multiple aircraft, specialized cameras, or other project-specific equipment.</small>
                  </span>
                </label>

              </div>

            </div>


            <!-- USAGE -->

            <div class="advanced-factor">

              <div class="factor-heading">
                <div>
                  <span class="factor-number">05</span>
                  <h4>USAGE RIGHTS</h4>
                </div>
              </div>

              <p class="factor-description">
                Consider how broadly the client will use the finished
                photography or video.
              </p>

              <div class="factor-options">

                <label class="factor-option">
                  <input type="radio" name="advanced-usage" value="0.95" checked />
                  <span>
                    <strong>Personal / Limited</strong>
                    <small>Personal use or a limited, non-commercial purpose.</small>
                  </span>
                </label>

                <label class="factor-option">
                  <input type="radio" name="advanced-usage" value="1.08" />
                  <span>
                    <strong>Business / Marketing</strong>
                    <small>Website, social media, advertising, promotional material, or normal business use.</small>
                  </span>
                </label>

                <label class="factor-option">
                  <input type="radio" name="advanced-usage" value="1.2" />
                  <span>
                    <strong>Commercial / Broad Usage</strong>
                    <small>Extensive commercial use, advertising campaigns, resale, licensing, or broad distribution.</small>
                  </span>
                </label>

              </div>

            </div>


            <!-- TURNAROUND -->

            <div class="advanced-factor">

              <div class="factor-heading">
                <div>
                  <span class="factor-number">06</span>
                  <h4>TURNAROUND</h4>
                </div>
              </div>

              <p class="factor-description">
                Faster delivery can require schedule changes,
                priority editing, or compressed production time.
              </p>

              <div class="factor-options">

                <label class="factor-option">
                  <input type="radio" name="advanced-turnaround" value="1" checked />
                  <span>
                    <strong>Standard</strong>
                    <small>Normal delivery timeframe with no unusual deadline.</small>
                  </span>
                </label>

                <label class="factor-option">
                  <input type="radio" name="advanced-turnaround" value="1.15" />
                  <span>
                    <strong>Rush</strong>
                    <small>Client needs the project completed faster than your normal turnaround.</small>
                  </span>
                </label>

                <label class="factor-option">
                  <input type="radio" name="advanced-turnaround" value="1.3" />
                  <span>
                    <strong>Same Day</strong>
                    <small>Capture and/or delivery is required on the same day.</small>
                  </span>
                </label>

              </div>

            </div>


            <!-- COMPLEXITY -->

            <div class="advanced-factor">

              <div class="factor-heading">
                <div>
                  <span class="factor-number">07</span>
                  <h4>PROJECT COMPLEXITY</h4>
                </div>
              </div>

              <p class="factor-description">
                Reflect the planning, coordination, location difficulty,
                number of deliverables, and other project-specific challenges.
              </p>

              <div class="factor-options">

                <label class="factor-option">
                  <input type="radio" name="advanced-complexity" value="1" checked />
                  <span>
                    <strong>Straightforward</strong>
                    <small>Simple location, predictable flight, clear deliverables, minimal complications.</small>
                  </span>
                </label>

                <label class="factor-option">
                  <input type="radio" name="advanced-complexity" value="1.12" />
                  <span>
                    <strong>Moderate</strong>
                    <small>Multiple considerations such as several shots, locations, deliverables, or additional planning.</small>
                  </span>
                </label>

                <label class="factor-option">
                  <input type="radio" name="advanced-complexity" value="1.3" />
                  <span>
                    <strong>Complex</strong>
                    <small>Challenging location, multiple locations, difficult conditions, extensive planning, specialized requirements, or significant coordination.</small>
                  </span>
                </label>

              </div>

            </div>


            <!-- ADVANCED RESULT -->

            <div class="advanced-result">

              <div>

                <p class="result-label">
                  ESTIMATED ADVANCED QUOTE
                </p>

                <div
                  id="advanced-recommended"
                  class="advanced-recommended"
                >
                  $475
                </div>

                <p id="advanced-range" class="advanced-range">
                  Estimated Market Range: $400 – $550
                </p>

              </div>

              <button
                id="advanced-update"
                type="button"
                class="estimate-button"
              >
                UPDATE ADVANCED ESTIMATE
                <span>→</span>
              </button>

            </div>


            <p class="advanced-disclaimer">
              This is still an estimate. The Advanced workflow adjusts
              the starting estimate based on the project factors you provide.
              It is not a guarantee of what a client or market will support.
            </p>

          </div>

        </Card>

      </div>

    </div>


    <!-- RESULTS -->

    <div
      id="results"
      class="results-wrapper"
      aria-hidden="true"
    >

      <Card padding="p-8 md:p-10" hover={false}>

        <div class="results-top">

          <div>

            <p class="mode-label">
              ESTIMATE RESULT
            </p>

            <h2>
              Estimated Local Market
            </h2>

          </div>

          <div
            id="confidence"
            class="confidence"
          >
            MODERATE CONFIDENCE
          </div>

        </div>


        <div class="result-main">

          <div>

            <p class="result-label">
              ESTIMATED MARKET RANGE
            </p>

            <div
              id="result-range"
              class="result-range"
            >
              $400 – $550
            </div>

          </div>

          <div class="recommended">

            <p class="result-label">
              ESTIMATED RECOMMENDED QUOTE
            </p>

            <div
              id="result-recommended"
              class="result-recommended"
            >
              $475
            </div>

          </div>

        </div>


        <div class="result-details">

          <div>

            <p class="detail-label">
              MARKET
            </p>

            <p id="result-market">
              —
            </p>

          </div>

          <div>

            <p class="detail-label">
              SERVICE
            </p>

            <p id="result-service">
              —
            </p>

          </div>

          <div>

            <p class="detail-label">
              PROJECT LEVEL
            </p>

            <p id="result-size">
              —
            </p>

          </div>

        </div>


        <div class="result-explanation">

          <p class="detail-label">
            HOW TO INTERPRET THIS ESTIMATE
          </p>

          <p id="result-copy">
            This estimate represents a starting point for evaluating
            your project's local market position. Actual pricing can
            vary based on deliverables, travel, production time,
            licensing, experience, and project requirements.
          </p>

        </div>


        <div class="result-actions">

          <div class="accuracy-cta">

            <p class="accuracy-title">
              Want a more accurate estimate?
            </p>

            <p class="accuracy-description">
              Account for travel, time, editing, equipment, usage rights,
              and project complexity.
            </p>

            <button
              id="customize-button"
              type="button"
              class="estimate-button"
            >
              GET A MORE ACCURATE QUOTE
              <span>→</span>
            </button>

          </div>

          <button
            id="new-estimate"
            type="button"
            class="text-button"
          >
            Start a new estimate
          </button>

        </div>

      </Card>

    </div>


    <!-- REPORT / EMAIL CAPTURE -->

    <div
      id="report-cta"
      class="report-cta"
      aria-hidden="true"
    >

      <div class="report-header">

        <p class="pricing-eyebrow">
          RAVENØRIX // PRICING REPORT
        </p>

        <h2>
          Get the complete<br />
          pricing report.
        </h2>

        <p class="report-description">
          We'll send you a professional breakdown of your estimated
          local market, recommended quote, pricing factors, and
          opportunities to increase your project value.
        </p>

      </div>


      <div class="report-form">

        <div class="email-field">

          <label for="report-email">
            EMAIL ADDRESS
          </label>

          <input
            id="report-email"
            type="email"
            placeholder="Enter your email address"
            autocomplete="email"
          />

        </div>

        <button
          id="report-button"
          type="button"
          class="report-button"
        >
          SEND MY PRICING REPORT
          <span>→</span>
        </button>

      </div>


      <label class="marketing-consent">

        <input
          id="marketing-consent"
          type="checkbox"
          checked
        />

        <span class="consent-check"></span>

        <span class="consent-copy">

          <strong>
            Keep me in the loop.
          </strong>

          <span>
            Send me occasional RavenØrix drone-business resources,
            pricing tips and updates.
          </span>

        </span>

      </label>


      <p class="report-note">
        Your email is used to deliver your requested pricing report.
      </p>

    </div>


    <!-- DISCLAIMER -->

    <div class="pricing-disclaimer">

      <p class="detail-label">
        PRICING DISCLAIMER
      </p>

      <p>
        RavenØrix Drone Pricing Calculator provides estimates for
        informational and educational purposes only. Results are
        based on available market data, location information and
        the inputs provided and are not a guarantee of what a
        particular client, market or project will support. Actual
        pricing should be determined by the operator based on their
        experience, operating costs, equipment, insurance, travel,
        production requirements, deliverables, licensing and
        applicable laws and regulations. RavenØrix does not provide
        legal, tax, financial or regulatory advice and is not
        responsible for pricing decisions made using this tool.
        Drone operators are responsible for ensuring their
        operations comply with all applicable federal, state and
        local requirements.
      </p>

    </div>

  </Container>

</section>


<style>

.pricing-page {
  min-height:100vh;
  padding:9rem 0 7rem;
  background:#050505;
}

.pricing-header {
  max-width:850px;
  margin:0 auto 4rem;
  text-align:center;
}

.pricing-eyebrow {
  margin:0;
  color:#8dd8ff;
  font-size:.72rem;
  font-weight:600;
  letter-spacing:.35em;
  text-transform:uppercase;
}

.pricing-header h1 {
  margin:1.5rem 0;
  font-family:"Bebas Neue",sans-serif;
  font-size:clamp(4rem,9vw,7rem);
  line-height:.88;
  text-transform:uppercase;
}

.pricing-header h1 span {
  color:rgba(255,255,255,.55);
}

.pricing-intro {
  max-width:650px;
  margin:0 auto;
  color:#9ca3af;
  font-size:1.1rem;
  line-height:1.8;
}

.mode-grid {
  display:grid;
  grid-template-columns:repeat(2,minmax(0,1fr));
  gap:1.5rem;
  max-width:1100px;
  margin:0 auto;
}

.mode-number {
  color:#8dd8ff;
  font-family:"Bebas Neue",sans-serif;
  font-size:2rem;
  line-height:1;
}

.mode-number.muted {
  color:#6b7280;
}

.mode-label {
  margin-top:1rem;
  color:#8dd8ff;
  font-size:.7rem;
  font-weight:700;
  letter-spacing:.28em;
}

.mode-label.muted {
  color:#9ca3af;
}

.mode-grid h2 {
  margin-top:1rem;
  font-family:"Bebas Neue",sans-serif;
  font-size:2.4rem;
  line-height:1;
  text-transform:uppercase;
}

.mode-description {
  margin-top:1rem;
  color:#9ca3af;
  line-height:1.7;
}

.mode-fields {
  display:flex;
  flex-direction:column;
  gap:1.5rem;
  margin-top:2rem;
}

.field {
  display:flex;
  flex-direction:column;
  gap:.6rem;
}

.field-heading {
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:1rem;
}

.field label,
.result-label,
.detail-label {
  color:#9ca3af;
  font-size:.65rem;
  font-weight:700;
  letter-spacing:.2em;
  text-transform:uppercase;
}

.field-hint {
  color:#4b5563;
  font-size:.62rem;
  letter-spacing:.08em;
  text-transform:uppercase;
}

.field input,
.field select {
  width:100%;
  padding:.95rem 1rem;
  border:1px solid rgba(255,255,255,.12);
  border-radius:.5rem;
  background:#0b0d10;
  color:white;
  outline:none;
  transition:border-color .2s,background .2s;
}

.field input::placeholder {
  color:#4b5563;
}

.field input:focus,
.field select:focus {
  border-color:#8dd8ff;
  background:#101419;
}

.field select option {
  background:#0b0d10;
  color:white;
}

.size-selector {
  display:grid;
  grid-template-columns:repeat(3,1fr);
  overflow:hidden;
  border:1px solid rgba(255,255,255,.14);
  border-radius:.55rem;
  background:#090b0e;
}

.size-segment {
  position:relative;
