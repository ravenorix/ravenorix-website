---
import RavenGridLayout from "../../layouts/RavenGridLayout.astro";

const groupLink =
  "https://groups.google.com/u/2/g/ravengrid";

const optInLink =
  "https://play.google.com/apps/testing/com.ravenorix.ravengrid";

const installLink =
  "https://play.google.com/store/apps/details?id=com.ravenorix.ravengrid";
---

<RavenGridLayout
  title="RavenGrid | Closed Beta"
  description="Join the RavenGrid closed beta for Android."
>

  <header>
    <div class="nav">

      <a href="/ravengrid" class="brand">
        RAVEN<span>GRID</span>
      </a>

      <nav>
        <a href="/ravengrid">RavenGrid</a>
        <a href="#steps">Join Beta</a>
        <a href="#install">Install</a>
        <a href="/ravengrid/privacy">Privacy</a>
      </nav>

    </div>
  </header>


  <main>

    <!-- HERO -->

    <section class="hero">

      <div class="hero-grid"></div>

      <div class="hero-content">

        <div class="status">
          <span class="status-dot"></span>
          CLOSED BETA / ANDROID
        </div>

        <div class="eyebrow">
          RAVENØRIX / RAVENGRID
        </div>

        <h1>
          JOIN THE<br />
          <span>BETA.</span>
        </h1>

        <div class="hero-divider"></div>

        <p class="hero-tagline">
          CHECK CONDITIONS.<br />
          <strong>MAKE A DECISION. FLY.</strong>
        </p>

        <p class="hero-description">
          RavenGrid is currently in closed beta. Joining takes
          three steps: join the RavenGrid group, opt into the
          Google Play test, then install the app.
        </p>

        <a href="#steps" class="primary">
          START BETA ACCESS
        </a>

      </div>

      <div class="hero-corner">
        <span>RG / BETA</span>
        <span>ANDROID</span>
      </div>

    </section>


    <!-- BETA STEPS -->

    <section id="steps" class="steps">

      <div class="steps-intro">

        <div class="section-label">
          BETA ACCESS
        </div>

        <h2>
          THREE STEPS.<br />
          <span>THAT'S IT.</span>
        </h2>

        <p>
          RavenGrid uses a Google Group to manage closed-beta
          access. Follow the steps in order using the same
          Google account throughout the process.
        </p>

        <div class="account-note">

          <span class="status-dot"></span>

          <div>
            <strong>USE ONE GOOGLE ACCOUNT</strong>

            <p>
              Make sure the Google account you use to join the
              group is the same account you use for Google Play
              testing and installation.
            </p>
          </div>

        </div>

      </div>


      <div class="step-list">

        <!-- STEP 01 -->

        <article class="step">

          <div class="step-number">
            01
          </div>

          <div class="step-content">

            <div class="step-label">
              JOIN THE GROUP
            </div>

            <h3>
              GET ON<br />
              <span>THE ROSTER.</span>
            </h3>

            <p>
              Join the RavenGrid Google Group. The group is open
              for anyone who wants to participate in the closed
              beta.
            </p>

            <a
              class="primary"
              href={groupLink}
              target="_blank"
              rel="noopener noreferrer"
            >
              JOIN RAVENGRID GROUP
            </a>

          </div>

        </article>


        <!-- STEP 02 -->

        <article class="step">

          <div class="step-number">
            02
          </div>

          <div class="step-content">

            <div class="step-label">
              OPT INTO THE TEST
            </div>

            <h3>
              ENTER THE<br />
              <span>TEST.</span>
            </h3>

            <p>
              After joining the group, open the Google Play
              closed-test enrollment page and opt into the
              RavenGrid test.
            </p>

            <a
              class="primary"
              href={optInLink}
              target="_blank"
              rel="noopener noreferrer"
            >
              JOIN CLOSED TEST
            </a>

          </div>

        </article>


        <!-- STEP 03 -->

        <article class="step">

          <div class="step-number">
            03
          </div>

          <div class="step-content">

            <div class="step-label">
              INSTALL RAVENGRID
            </div>

            <h3>
              READY TO<br />
              <span>FLY.</span>
            </h3>

            <p>
              Once you've opted into the test, open the RavenGrid
              Google Play listing and install the app on your
              Android device.
            </p>

            <a
              class="primary"
              href={installLink}
              target="_blank"
              rel="noopener noreferrer"
            >
              INSTALL RAVENGRID
            </a>

          </div>

        </article>

      </div>

    </section>


    <!-- INSTALL -->

    <section id="install" class="install">

      <div class="install-inner">

        <div class="section-label">
          FINAL CHECK
        </div>

        <h2>
          READY TO<br />
          <span>INSTALL?</span>
        </h2>

        <p>
          If you've completed the group and test enrollment
          steps, you're ready to install RavenGrid from Google
          Play.
        </p>

        <a
          class="primary"
          href={installLink}
          target="_blank"
          rel="noopener noreferrer"
        >
          INSTALL RAVENGRID
        </a>

        <div class="install-warning">

          <span class="status-dot"></span>

          <p>
            If Google Play says you're not eligible for the test,
            verify that you joined the RavenGrid group and that
            you're signed into Google Play with the same Google
            account.
          </p>

        </div>

      </div>

    </section>


    <!-- BETA FEEDBACK -->

    <section class="feedback">

      <div class="feedback-inner">

        <div class="section-label">
          RAVENGRID / CLOSED BETA
        </div>

        <h2>
          HELP US<br />
          <span>BUILD IT.</span>
        </h2>

        <p>
          RavenGrid is being built for pilots who want fast,
          clear flight-condition information without unnecessary
          clutter. During the beta, your feedback helps shape
          what comes next.
        </p>

        <a href="/ravengrid" class="secondary">
          RETURN TO RAVENGRID
        </a>

      </div>

    </section>

  </main>


  <footer>

    <div class="footer-brand">
      RAVEN<span>GRID</span>
    </div>

    <div class="footer-links">
      <a href="/ravengrid">RavenGrid</a>
      <a href="/ravengrid/privacy">Privacy Policy</a>

      <a
        href="https://ravenorix.com"
        target="_blank"
        rel="noopener noreferrer"
      >
        RavenØrix
      </a>
    </div>

    <div class="copyright">
      © 2026 RavenØrix
    </div>

  </footer>

</RavenGridLayout>


<style>

  :global(html) {
    scroll-behavior: smooth;
  }


  :global(body) {
    background: #08090b;
    color: #e5e7eb;
  }


  :global(*) {
    box-sizing: border-box;
  }


  header {
    position: relative;
    z-index: 20;
    border-bottom: 1px solid #24262a;
    background: rgba(8, 9, 11, 0.96);
  }


  .nav {
    max-width: 1280px;
    margin: auto;
    padding: 20px 28px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }


  .brand {
    color: #f3f4f6;
    text-decoration: none;
    font-size: 15px;
    font-weight: 900;
    letter-spacing: 0.16em;
  }


  .brand span,
  footer span,
  h1 span,
  h2 span,
  h3 span {
    color: #a71930;
  }


  nav {
    display: flex;
    gap: 28px;
  }


  nav a,
  .footer-links a {
    color: #777c84;
    text-decoration: none;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    transition: color 0.2s ease;
  }


  nav a:hover,
  .footer-links a:hover {
    color: #f3f4f6;
  }


  /* HERO */


  .hero {
    position: relative;
    min-height: 700px;
    overflow: hidden;
    display: flex;
    align-items: center;
    border-bottom: 1px solid #24262a;

    background:
      radial-gradient(
        circle at 80% 30%,
        rgba(167, 25, 48, 0.12),
        transparent 32%
      ),
      #08090b;
  }


  .hero::after {
    content: "";
    position: absolute;
    inset: 0;

    background:
      linear-gradient(
        90deg,
        transparent 0,
        transparent 55%,
        rgba(167,25,48,0.04) 100%
      );

    pointer-events: none;
  }


  .hero-grid {
    position: absolute;
    inset: 0;
    opacity: 0.16;

    background-image:
      linear-gradient(
        rgba(255,255,255,0.07) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(255,255,255,0.07) 1px,
        transparent 1px
      );

    background-size: 60px 60px;

    mask-image: linear-gradient(
      90deg,
      black,
      transparent 90%
    );
  }


  .hero-content {
    position: relative;
    z-index: 2;

    width: 100%;
    max-width: 1280px;
    margin: auto;

    padding: 110px 28px;
  }


  .status {
    display: inline-flex;
    align-items: center;
    gap: 9px;

    color: #c0203b;

    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.18em;

    margin-bottom: 24px;
  }


  .status-dot {
    width: 7px;
    height: 7px;
    flex: 0 0 auto;

    border-radius: 50%;

    background: #a71930;

    box-shadow:
      0 0 14px rgba(167, 25, 48, 0.8);
  }


  .eyebrow,
  .section-label {
    color: #a71930;

    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.2em;
  }


  h1 {
    margin: 22px 0 0;

    font-size: clamp(58px, 9vw, 112px);
    line-height: 0.86;

    letter-spacing: -0.055em;

    font-weight: 900;
  }


  .hero-divider {
    width: 90px;
    height: 2px;

    margin: 34px 0 25px;

    background: #a71930;
  }


  .hero-tagline {
    margin: 0;

    color: #f3f4f6;

    font-size: clamp(22px, 3vw, 32px);
    line-height: 1.1;

    font-weight: 400;
    letter-spacing: 0.03em;
  }


  .hero-tagline strong {
    font-weight: 900;
  }


  .hero-description {
    max-width: 600px;

    margin: 24px 0 30px;

    color: #a3a8b0;

    font-size: 16px;
    line-height: 1.75;
  }


  .hero-corner {
    position: absolute;
    z-index: 2;

    right: 28px;
    bottom: 28px;

    display: flex;
    gap: 22px;

    color: #62666d;

    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.15em;
  }


  /* BUTTONS */


  .primary,
  .secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    min-height: 48px;

    padding: 0 22px;

    border-radius: 0;

    text-decoration: none;

    font-size: 10px;
    font-weight: 900;
    letter-spacing: 0.14em;
    text-transform: uppercase;

    transition:
      background 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease,
      transform 0.2s ease;
  }


  .primary {
    border: 1px solid #a71930;

    background: #a71930;
    color: #ffffff;
  }


  .primary:hover {
    background: #c0203b;
    border-color: #c0203b;
    transform: translateY(-1px);
  }


  .secondary {
    border: 1px solid #3a3d42;

    background: transparent;
    color: #d7dae0;
  }


  .secondary:hover {
    border-color: #a71930;
    color: #ffffff;
  }


  /* STEPS */


  .steps {
    max-width: 1280px;
    margin: auto;

    padding: 120px 28px;

    display: grid;
    grid-template-columns: 0.72fr 1.28fr;

    gap: 100px;

    border-bottom: 1px solid #24262a;
  }


  .steps-intro h2,
  .install h2,
  .feedback h2 {
    margin: 22px 0 28px;

    color: #f3f4f6;

    font-size: clamp(42px, 6vw, 70px);
    line-height: 0.92;

    letter-spacing: -0.045em;

    font-weight: 900;
  }


  .steps-intro > p,
  .install-inner > p,
  .feedback-inner > p {
    max-width: 520px;

    color: #92979f;

    font-size: 15px;
    line-height: 1.8;
  }


  .account-note {
    margin-top: 45px;

    display: flex;
    gap: 15px;

    padding-top: 20px;

    border-top: 1px solid #24262a;
  }


  .account-note .status-dot {
    margin-top: 4px;
  }


  .account-note strong {
    display: block;

    color: #d7dae0;

    font-size: 10px;
    font-weight: 900;

    letter-spacing: 0.14em;
  }


  .account-note p {
    margin: 8px 0 0;

    color: #686d75;

    font-size: 12px;
    line-height: 1.65;
  }


  .step-list {
    border-top: 1px solid #24262a;
  }


  .step {
    display: grid;
    grid-template-columns: 80px 1fr;

    min-height: 250px;

    border-bottom: 1px solid #24262a;
  }


  .step-number {
    padding-top: 30px;

    color: #a71930;

    font-size: 11px;
    font-weight: 900;
    letter-spacing: 0.14em;
  }


  .step-content {
    padding: 30px 0;
  }


  .step-label {
    color: #a71930;

    font-size: 9px;
    font-weight: 900;

    letter-spacing: 0.18em;
  }


  h3 {
    margin: 14px 0 18px;

    color: #f3f4f6;

    font-size: clamp(30px, 4vw, 46px);
    line-height: 0.9;

    letter-spacing: -0.04em;

    font-weight: 900;
  }


  .step-content p {
    max-width: 570px;

    margin: 0 0 24px;

    color: #858a92;

    font-size: 14px;
    line-height: 1.75;
  }


  /* INSTALL */


  .install {
    border-bottom: 1px solid #24262a;

    background:
      linear-gradient(
        90deg,
        rgba(167,25,48,0.025),
        transparent 60%
      );
  }


  .install-inner {
    max-width: 1280px;
    margin: auto;

    padding: 120px 28px;
  }


  .install-inner > p {
    margin-bottom: 30px;
  }


  .install-warning {
    max-width: 620px;

    margin-top: 35px;

    padding-top: 20px;

    display: flex;
    gap: 12px;

    border-top: 1px solid #24262a;
  }


  .install-warning p {
    margin: 0;

    color: #686d75;

    font-size: 12px;
    line-height: 1.7;
  }


  /* FEEDBACK */


  .feedback {
    border-bottom: 1px solid #24262a;
  }


  .feedback-inner {
    max-width: 1280px;
    margin: auto;

    padding: 120px 28px;
  }


  .feedback-inner > p {
    margin-bottom: 30px;
  }


  /* FOOTER */


  footer {
    max-width: 1280px;
    margin: auto;

    padding: 30px 28px;

    display: grid;

    grid-template-columns: 1fr auto auto;

    align-items: center;

    gap: 40px;
  }


  .footer-brand {
    color: #f3f4f6;

    font-size: 13px;
    font-weight: 900;

    letter-spacing: 0.16em;
  }


  .footer-links {
    display: flex;
    gap: 24px;
  }


  .copyright {
    color: #4f5359;

    font-size: 9px;
    font-weight: 700;

    letter-spacing: 0.12em;
    text-transform: uppercase;
  }


  /* RESPONSIVE */


  @media (max-width: 850px) {

    nav {
      gap: 16px;
    }

    nav a {
      font-size: 9px;
    }

    .steps {
      grid-template-columns: 1fr;
      gap: 60px;
    }

    .steps-intro > p {
      max-width: 650px;
    }

    footer {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .footer-links {
      flex-wrap: wrap;
    }

  }


  @media (max-width: 600px) {

    .nav {
      padding: 18px 20px;
    }

    nav a:nth-child(1) {
      display: none;
    }

    .hero {
      min-height: 650px;
    }

    .hero-content {
      padding: 90px 20px;
    }

    .hero-corner {
      right: 20px;
      bottom: 20px;
      flex-direction: column;
      align-items: flex-end;
      gap: 7px;
    }

    .steps,
    .install-inner,
    .feedback-inner {
      padding: 90px 20px;
    }

    .step {
      grid-template-columns: 55px 1fr;
    }

    .step-number {
      padding-top: 25px;
    }

    .step-content {
      padding: 25px 0;
    }

    .primary,
    .secondary {
      width: 100%;
    }

    footer {
      padding: 30px 20px;
    }

  }

</style>